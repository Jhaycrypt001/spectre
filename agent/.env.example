# Spectre agent — environment configuration.
# Copy to `.env` and fill in as needed. Every value has a working default except the
# secret key, so the only thing you *must* provide is the Casper key to sign with.

# --- Casper (required to send transactions) --------------------------------------
# Path to the account secret key exported from Casper Wallet (menu -> Download
# account keys). Defaults to ../keys/testnet_secret_key.pem.
# CASPER_SECRET_KEY=../keys/testnet_secret_key.pem

# RPC node, chain name, and explorer. Defaults target Casper testnet.
# CASPER_RPC_URL=https://node.testnet.casper.network/rpc
# CASPER_CHAIN_NAME=casper-test
# CASPER_EXPLORER=https://testnet.cspr.live

# Backdate applied to transaction timestamps, ms, to survive host clock drift.
# CASPER_TIME_OFFSET_MS=60000

# --- AI explanation layer (optional) ---------------------------------------------
# The agent's DECISIONS are deterministic and need no model. This key only powers the
# natural-language explanation of a decision. If it is absent the agent falls back to
# its own deterministic rationale, so leaving this unset changes wording, not behaviour.
# ANTHROPIC_API_KEY=sk-ant-...
